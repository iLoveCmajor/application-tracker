{
  "uid": "application-tracker",
  "title": "Application Tracker: status changes",
  "description": "The status-change journey (#29): metric, trace and log lines of each request, linked by trace id.",
  "tags": [
    "application-tracker"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Status changes (from → to), per minute",
      "description": "app_status_changes_total. The dots are exemplars: hover one and click \"View trace\" to open that request in Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (from, to) (increase(app_status_changes_total[1m]))",
          "legendFormat": "{{from}} → {{to}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request duration p95 by route",
      "description": "http_server_request_duration_seconds, the HTTP server histogram. Exemplars link to traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Status-change traces",
      "description": "Tempo: the latest change_status spans. Click a trace id to open the trace; from a span, \"Logs for this span\" opens its log lines in Loki.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"change_status\" }",
          "limit": 100,
          "tableType": "traces"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Status-change request log lines",
      "description": "Loki: the app's JSON lines for status-change requests. Each has trace_id; expand a line and click \"View trace\".",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"application-tracker\"} |= \"/status\""
        }
      ]
    }
  ]
}
