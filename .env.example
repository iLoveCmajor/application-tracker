# Copy to .env to override. Every setting is optional; the defaults below are what Compose uses.

# SQLAlchemy URL of the database. Unset: sqlite:///./tracker.db next to where the API starts.
# Compose sets it to its own PostgreSQL service.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# Log level, any case: DEBUG, INFO, WARNING, ERROR, CRITICAL. Unset or unknown: INFO.
# Logs are JSON lines on stdout, one per request with a request id (X-Request-ID).
LOG_LEVEL=INFO

# true: on start, an empty database gets about ten invented demo applications. Compose defaults to true.
SEED_DEMO_DATA=false

# Version reported by /health. Unset: RENDER_GIT_COMMIT, else "dev".
APP_VERSION=dev

# Built frontend to serve at / (the Docker image sets /app/static). Unset: API only, `make dev` uses Vite.
# STATIC_DIR=../frontend/dist

# Compose only: host ports and the database password.
# APP_PORT=8080
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=tracker

# Tests only: PostgreSQL for `make test-integration`. Unset: a postgres:16 container via testcontainers.
# The tests drop and recreate the schema, so use the throwaway database Compose creates:
# TEST_DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker_test
